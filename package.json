{
  "name": "svg-editor-phase1",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript OO SVG CLI with Command, Composite and transactional undo/redo",
  "type": "module",
  "engines": { "node": ">=20.14" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/src/main.js",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "check:architecture": "npm run build --silent && node dist/tools/ArchitectureCheck.js",
    "check": "npm test && npm run check:architecture"
  }
}
